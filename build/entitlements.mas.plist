<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: the app runs in Apple's sandbox. Each key below is a door
       the Mycology edition actually uses; anything not listed stays shut. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>6QLMV9UCPP.com.crowelogic.mycology</string>
  </array>
  <!-- Gateway, Crowe ID and the shared farm backend. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Crowe ID sign-in returns to a loopback listener on 127.0.0.1. -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Backups, exports and document intake go through the open/save panels. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Dictation into the composer. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
</dict>
</plist>
