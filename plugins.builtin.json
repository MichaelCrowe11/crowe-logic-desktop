{
  "version": 1,
  "plugins": [
    {
      "id": "crowe-skills",
      "name": "Crowe Skills",
      "description": "The Crowe skills corpus: search and load playbooks for cultivation, engineering, commerce, and studio work.",
      "category": "knowledge",
      "spaces": [
        "chat",
        "projects",
        "cultivation"
      ],
      "official": true,
      "available": true,
      "mcp": {
        "command": "python3",
        "args": [
          "~/crowe-skills/mcp_server.py"
        ],
        "env": {}
      },
      "envPrompts": [],
      "tools": [
        {
          "match": "*",
          "tier": "readonly"
        }
      ],
      "glyph": "hexbloom",
      "chips": [
        "Find the skill for planning a substrate run"
      ]
    },
    {
      "id": "crowe-sense",
      "name": "Crowe Sense",
      "description": "The grow-room sensing node: readings, history, the device descriptor, and its two operations. Writes reach the node only on the direct path, with its operator token, behind an approval every time.",
      "category": "cultivation",
      "spaces": [
        "cultivation"
      ],
      "official": true,
      "available": true,
      "mcp": {
        "command": "python3",
        "args": [
          "~/crowe-sense/mcp_server.py"
        ],
        "env": {}
      },
      "envPrompts": [
        {
          "key": "CROWE_SENSE_URL",
          "label": "Node API URL on the LAN or tailnet, e.g. http://100.123.229.57:8078"
        },
        {
          "key": "CROWE_SENSE_OPERATOR_TOKEN",
          "label": "Operator token for writes (optional; the node's /etc/crowe/operator.token)"
        }
      ],
      "tools": [
        {
          "match": "describe_*",
          "tier": "readonly"
        },
        {
          "match": "read_*",
          "tier": "readonly"
        },
        {
          "match": "list_*",
          "tier": "readonly"
        },
        {
          "match": "request_operation",
          "tier": "execute",
          "physical": true
        },
        {
          "match": "*",
          "tier": "execute",
          "physical": true
        }
      ],
      "glyph": "mycelial",
      "chips": [
        "What is the fruiting room reading right now?",
        "Chart the last 72h of fruiting-room humidity",
        "Describe the sensor node and what it can do"
      ]
    },
    {
      "id": "parallel-synth",
      "name": "Parallel Synth",
      "description": "Film timeline co-editing: the operator reads and edits psynth project docs alongside you.",
      "category": "media",
      "spaces": [
        "projects"
      ],
      "official": true,
      "available": false,
      "mcp": null,
      "envPrompts": [],
      "tools": [
        {
          "match": "read_*",
          "tier": "readonly"
        },
        {
          "match": "*",
          "tier": "edit"
        }
      ],
      "glyph": "facet",
      "chips": []
    },
    {
      "id": "talon-music",
      "name": "Talon Music",
      "description": "Crowe Talon composes and produces through the gateway.",
      "category": "media",
      "spaces": [
        "projects"
      ],
      "official": true,
      "available": false,
      "mcp": null,
      "envPrompts": [],
      "tools": [
        {
          "match": "*",
          "tier": "edit"
        }
      ],
      "glyph": "coalesce",
      "chips": []
    },
    {
      "id": "gateway-ops",
      "name": "Gateway Ops",
      "description": "Deployment health and eval runs across the CroweLM fleet.",
      "category": "ops",
      "spaces": [
        "projects"
      ],
      "official": true,
      "available": false,
      "mcp": null,
      "envPrompts": [],
      "tools": [
        {
          "match": "*",
          "tier": "readonly"
        }
      ],
      "glyph": "meshwork",
      "chips": []
    },
    {
      "id": "r2-storage",
      "name": "R2 Storage",
      "description": "Browse releases, datasets, and artifacts in the Crowe R2 buckets.",
      "category": "data",
      "spaces": [
        "projects"
      ],
      "official": true,
      "available": false,
      "mcp": null,
      "envPrompts": [
        {
          "key": "R2_TOKEN",
          "label": "Cloudflare R2 API token"
        }
      ],
      "tools": [
        {
          "match": "list_*",
          "tier": "readonly"
        },
        {
          "match": "get_*",
          "tier": "readonly"
        },
        {
          "match": "put_*",
          "tier": "edit"
        }
      ],
      "glyph": "iris",
      "chips": []
    },
    {
      "id": "swm-commerce",
      "name": "SWM Commerce",
      "description": "Southwest Mushrooms storefront analytics: Shopify orders and Stripe revenue, read-only.",
      "category": "commerce",
      "spaces": [
        "projects"
      ],
      "official": true,
      "available": false,
      "mcp": null,
