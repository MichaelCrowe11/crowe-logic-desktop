{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crowe-releases",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "crowe-releases" }
  ],
  "routes": [
    { "pattern": "releases.crowelogic.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
