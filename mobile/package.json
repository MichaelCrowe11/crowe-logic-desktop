{
  "name": "crowe-logic-mobile",
  "productName": "Crowe Logic",
  "version": "0.26.21",
  "private": true,
  "description": "Crowe Logic for iOS and Android: the same operator UI as the desktop app, over the CroweLM gateway, in a Capacitor shell.",
  "license": "LicenseRef-Proprietary",
  "scripts": {
    "www": "node scripts/build-www.js",
    "sync": "node scripts/build-www.js && cap sync",
    "ios": "node scripts/build-www.js && cap sync ios && cap open ios",
    "android": "node scripts/build-www.js && cap sync android && cap open android",
    "serve": "node scripts/build-www.js && node scripts/serve.js",
    "test": "node ../scripts/test-mobile-bridge.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
