{
  "name": "crowe-logic-desktop",
  "productName": "Crowe Logic",
  "version": "0.22.0",
  "description": "Crowe Logic desktop: an agentic operator over the CroweLM gateway. Chat, real PTY terminal, in-app browser, file tree, reviewable edits, and MCP tools. Cross-platform (Windows, Linux, macOS).",
  "main": "main.js",
  "author": {
    "name": "Crowe Logic, Inc.",
    "email": "michael@crowelogic.com"
  },
  "homepage": "https://crowelogic.com",
  "license": "LicenseRef-Proprietary",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac && node scripts/staple-dmg.js release",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "smoke": "electron scripts/smoke-shot.js",
    "test": "node scripts/test-harness.js && node scripts/test-mobile-bridge.js && node scripts/test-qr.js && node scripts/test-packaging.js && node scripts/test-companion.js && node scripts/check-contrast.js && node scripts/gen-preview.js --check && node scripts/test-releases-worker.js && node scripts/test-verify-release.js && electron scripts/test-icons.js && electron scripts/test-panels.js && electron scripts/test-mobile-shell.js && electron scripts/test-install-spaces.js && CROWE_SPACES=chat,projects electron scripts/test-install-spaces.js",
    "check:contrast": "node scripts/check-contrast.js",
    "preview:gen": "node scripts/gen-preview.js",
    "preview:check": "node scripts/gen-preview.js --check",
    "preview": "node scripts/gen-preview.js && python3 -m http.server 8731 --directory .",
    "publish:r2": "bash scripts/publish-r2.sh release",
    "verify:release": "node scripts/verify-release.js",
    "icons": "node scripts/gen-mark.js && electron scripts/make-icons.js",
    "mobile:www": "node mobile/scripts/build-www.js",
    "mobile:test": "node scripts/test-mobile-bridge.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "com.crowelogic.desktop",
    "productName": "Crowe Logic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "harness.js",
      "grow-schema.js",
      "preload.js",
      "companion.js",
      "qr.js",
      "mcp-demo-server.js",
      "renderer/**",
      "assets/**",
      "plugins.builtin.json",
      "node_modules/@xterm/**",
      "node_modules/node-pty/**",
      "node_modules/node-gyp-build/**",
      "node_modules/argparse/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/debug/**",
      "node_modules/electron-updater/**",
      "node_modules/fs-extra/**",
      "node_modules/graceful-fs/**",
      "node_modules/js-yaml/**",
      "node_modules/jsonfile/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "node_modules/semver/**",
      "node_modules/tiny-typed-emitter/**",
      "node_modules/universalify/**",
      "!renderer/preview.html",
      "!renderer/preview-shim.js"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "Michael Crowe (6QLMV9UCPP)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "CroweLogic-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 (>= 1.0.16)"
      ]
    },
    "afterSign": "build/notarize.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://crowe-releases.yellow-block-3adc.workers.dev/desktop/channel/${os}",
        "channel": "latest"
      }
    ]
  }
}
