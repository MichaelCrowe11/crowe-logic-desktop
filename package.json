{
  "name": "crowe-logic-desktop",
  "productName": "Crowe Logic",
  "version": "0.5.1",
  "description": "Crowe Logic desktop: an agentic operator over the CroweLM gateway. Chat, real PTY terminal, in-app browser, file tree, reviewable edits, and MCP tools. Cross-platform (Windows, Linux, macOS).",
  "main": "main.js",
  "author": {
    "name": "Crowe Logic, Inc.",
    "email": "michael@crowelogic.com"
  },
  "homepage": "https://crowelogic.com",
  "license": "LicenseRef-Proprietary",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crowelogic.desktop",
    "productName": "Crowe Logic",
    "files": [
      "main.js",
      "harness.js",
      "preload.js",
      "mcp-demo-server.js",
      "renderer/**",
      "assets/**",
      "node_modules/@xterm/**",
      "node_modules/node-pty/**",
      "node_modules/node-gyp-build/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "Michael Crowe (6QLMV9UCPP)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": {
        "teamId": "6QLMV9UCPP"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 (>= 1.0.16)"
      ]
    }
  }
}